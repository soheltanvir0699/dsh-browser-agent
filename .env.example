# Copy to .env and choose ONE provider (fill in its key).

# ── Groq — free, very fast, recommended ─────────────────────────────
# Free key (no credit card): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Google Gemini — free, strong reasoning ──────────────────────────
# Free key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# ── Local Ollama — free, offline (needs decent RAM/CPU) ─────────────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b

# Strict JSON mode: keep false for reasoning models (gpt-oss). Set true only
LLM_JSON_MODE=false

# Dedicated browser profile (persisted logins live here).
AGENT_PROFILE_DIR=./.agent-profile

# ── Vision fallback (optional) — screenshots the page when stuck ─────
# Needs a vision model (gpt-oss has none). Free Gemini key works:
# VISION_API_KEY=
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_MODEL=gemini-2.0-flash
