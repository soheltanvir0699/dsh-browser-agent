    "playwright",
    "groq",
    "web-agent",
    "agentic-ai",
    "computer-use",
    "ai-assistant",
    "chatbot",
    "browser-use",
    "open-source"
  ],
  "homepage": "https://github.com/soheltanvir0699/scout-ai-browser-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soheltanvir0699/scout-ai-browser-agent.git"
  },
  "bin": {
    "scout": "./index.js"
  },
  "scripts": {
